# MongoDB Atlas
ATLAS_URI=mongodb://admin:password@localhost:27017/?authSource=admin

# Local Database (Fallback)
LOCAL_URI=mongodb://127.0.0.1:27017/myLocalDatabase
API_BASE=http://localhost:3001
BUN_PUBLIC_API_BASE=$API_BASE

PORT=3000

SESSION_SECRET=replace-this-with-a-session-secret

BUN_PUBLIC_GOOGLE_MAPS_API_KEY=paste-your-key-here

# Cloudinary (required for image uploads)
# Find these values on your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
